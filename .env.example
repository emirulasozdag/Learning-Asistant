# Bu dosyayı .env olarak kopyalayın: cp .env.example .env
# .env dosyası git'e girmez.

# --- PostgreSQL + pgvector ---
POSTGRES_USER=learning
POSTGRES_PASSWORD=learning
POSTGRES_DB=learning_assistant
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://learning:learning@localhost:5432/learning_assistant

# --- API ---
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- Oturum ve hesaplar (DECISIONS.md ADR-1) ---
# HTTPS arkasında (üretim) true: oturum çerezi yalnızca şifreli bağlantıda gönderilir.
SESSION_COOKIE_SECURE=false
# Demo hesapları ve sunum modu docker-compose.yml'de varsayılan AÇIK (yalnızca yerel geliştirme):
# Dr. Ayşe Demir (eğitmen) ve Elif Kaya (öğrenci) açılışta oluşturulur; giriş ekranında tek tıkla
# girilir ve derslerin katılım kodları görünür. Değiştirmek için aşağıdakileri açın.
# Gerçek kurulumda ikisi de false olmalı.
# SEED_DEV_ACCOUNTS=true
# DEMO_LOGIN=true
# DEV_INSTRUCTOR_EMAIL=ayse.demir@universite.edu.tr
# DEV_INSTRUCTOR_PASSWORD=
# DEV_STUDENT_EMAIL=elif.kaya@ogr.universite.edu.tr
# DEV_STUDENT_PASSWORD=
# Gerçek eğitmen hesabı: docker compose exec api python -m app.scripts.create_instructor --email ... --name ...

# --- LLM ---
# Anahtar boş bırakılırsa sistem LLM'siz çalışır: cevap yerine en ilgili ders
# parçası kaynağıyla gösterilir. Seçim ve gerekçe: docs/DECISIONS.md ADR-7.
# gemini (doğrudan Gemini API) | openrouter (tek anahtarla Claude, GPT...) | anthropic
LLM_PROVIDER=gemini
# Anahtarı SADECE bu .env dosyasına yazın; asla commit'lemeyin. Gemini: https://aistudio.google.com/apikey
# Ücretsiz katmanda gönderilen içerik Google ürünlerini geliştirmede kullanılabilir: yalnızca
# herkese açık materyal ve sentetik sorularla geliştirme yapın. Pilot ücretli katmanla (billing).
LLM_API_KEY=
# Boş bırakılırsa sağlayıcının varsayılanı. Gemini: üretici gemini-3.8-flash,
# orkestratör gemini-3.5-flash-lite. OpenRouter örneği: LLM_MODEL=anthropic/claude-opus-5.5
LLM_MODEL=
LLM_ORCHESTRATOR_MODEL=
# Gemini düşünme seviyesi (minimal | low | medium | high); düşünme token'ları çıktı olarak ücretlenir.
LLM_THINKING_LEVEL=low
LLM_ORCHESTRATOR_THINKING_LEVEL=minimal
# Pratik sorusunu anahtarı görmeden çözen kontrolcü; boşsa üretici modeli (ayrı çağrı).
LLM_CHECKER_MODEL=
LLM_CHECKER_THINKING_LEVEL=low
# OpenAI uyumlu uç nokta (yalnızca openrouter). Yerel model (Ollama): http://host.docker.internal:11434/v1
LLM_BASE_URL=https://openrouter.ai/api/v1

# --- AI Tutor ---
# Materyalde olmayan ama ders alanı içindeki sorulara "genel bilgi" etiketli açıklama
# (ADR-7). Eğitmen/ekip kararı verilene kadar kapalı.
TUTOR_GENERAL_KNOWLEDGE=false
# Kaynaklı cevapta yeniden sıralama: bu kadar aday puanlanır, en iyileri üreticiye gider (0 = kapalı).
TUTOR_RERANK_CANDIDATES=20
TUTOR_RERANK_KEEP=6

# --- Embedding (anlamsal arama) ---
# e5: yerel multilingual-e5 modeli (ilk açılışta bir kez ~1 GB indirilir)
# fake: model indirmeden çalışır, anlamsal arama yapmaz (testler için)
EMBEDDING_PROVIDER=e5
EMBEDDING_MODEL=intfloat/multilingual-e5-base
# Alakasızlık kapısı: anlamsal benzerlik ya da anahtar kelime kapsaması (0-1) eşiğin altındaysa
# soru "materyalde yok" sayılır. Takip sorusu önceki soruyla birlikte ancak kendi benzerliği
# tabanın üstündeyse kabul edilir. Kalibrasyon: evaluation/README.md, "Arama kalibrasyonu".
RETRIEVAL_MIN_SIMILARITY=0.78
RETRIEVAL_MIN_KEYWORD_COVERAGE=0.5
RETRIEVAL_FOLLOW_UP_MIN_SIMILARITY=0.77

# --- Web ---
WEB_PORT=5173
