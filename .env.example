# Bu dosyayı .env olarak kopyalayın: cp .env.example .env
# .env dosyası git'e girmez.

# --- PostgreSQL + pgvector ---
POSTGRES_USER=learning
POSTGRES_PASSWORD=learning
POSTGRES_DB=learning_assistant
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://learning:learning@localhost:5432/learning_assistant

# --- API ---
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- LLM ---
# Anahtar boş bırakılırsa sistem LLM'siz çalışır: cevap yerine en ilgili ders
# parçası kaynağıyla gösterilir.
# openrouter (tek anahtarla Claude, GPT, Gemini...) | anthropic (doğrudan Claude)
LLM_PROVIDER=openrouter
# Anahtarı SADECE bu .env dosyasına yazın; asla commit'lemeyin.
LLM_API_KEY=
# OpenRouter model kimliği. Daha ucuz: anthropic/claude-haiku-5.5
# (LLM_PROVIDER=anthropic ise: claude-opus-5-5)
LLM_MODEL=anthropic/claude-opus-5.5
# OpenAI uyumlu uç nokta. Yerel model (Ollama) için: http://host.docker.internal:11434/v1
LLM_BASE_URL=https://openrouter.ai/api/v1

# --- Embedding (anlamsal arama) ---
# e5: yerel multilingual-e5 modeli (ilk açılışta bir kez ~1 GB indirilir)
# fake: model indirmeden çalışır, anlamsal arama yapmaz (testler için)
EMBEDDING_PROVIDER=e5
EMBEDDING_MODEL=intfloat/multilingual-e5-base
# Hiç kelime eşleşmesi yokken anlamsal benzerlik bunun altındaysa soru "materyalde yok" sayılır.
RETRIEVAL_MIN_SIMILARITY=0.78

# --- Web ---
WEB_PORT=5173
